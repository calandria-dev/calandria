# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
# the desktop shell spike installs its own Electron (~280 MB) — see desktop/README.md
/desktop/node_modules
/desktop/dist
# packaging intermediates: the staged server payload and the vendored Node
# runtime (scripts/build-payload.js) — both regenerated, both large
/desktop/payload
/desktop/vendor
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
# optional local vitest env layer (see vitest.config.ts setupFiles)
/tests/setup.local.ts

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# machine-local files. The `.local.` infix is the near-universal signal for
# "this describes THIS machine" — host paths, LAN addresses, ports, credential
# wiring — none of which belongs in a public repo. A `docker-compose.local.yml`
# was a tracked file here once, which is the gap this closes.
# Opt in the same way .env.example does, with an explicit negation:
#   !docker-compose.local.yml
*.local.*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python bytecode cache
__pycache__/
*.pyc

# local db (calandria.db; orchestrator.db is the pre-rename name, still read)
calandria.db
calandria.db-shm
calandria.db-wal
orchestrator.db
orchestrator.db-shm
orchestrator.db-wal

# per-task git worktrees
/worktrees/

# screenshots / playwright artifacts
.playwright-mcp/
/test-results/
/playwright-report/
*.png
# ...except README/docs images, which must be committed
!docs/images/
!docs/images/*.png
!app/apple-icon.png
!app/opengraph-image.png
!docs/design/og.png
!public/icons/*.png
!desktop/assets/*.png
!website/public/*.png
