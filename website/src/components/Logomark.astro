---
/* docs/design/handoff/assets/logo.svg, inline so it tints with `currentColor`
   (the file is byte-identical apart from formatting). 3x3 isometric lattice of
   control rods, each in an open channel ring, fading out from the raised
   centre rod. Below 14px the handoff calls for assets/favicon-small.svg
   instead; nothing here renders it that small. */
interface Props {
  size: string;
  class?: string;
}
const { size, class: className } = Astro.props;
---

<svg
  class={className}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="4.78 6.6 14.45 17.23"
  fill="none"
  aria-hidden="true"
  style={`height:${size};width:auto`}
>
  <ellipse cx="12" cy="16.6" rx="1.75" ry=".95" stroke="currentColor" stroke-width=".55" opacity=".21"></ellipse>
  <rect x="10.95" y="7.1" width="2.1" height="9.5" rx="1.05" fill="currentColor" opacity=".3"></rect>
  <ellipse cx="14.6" cy="18.1" rx="1.75" ry=".95" stroke="currentColor" stroke-width=".55" opacity=".385"></ellipse>
  <rect x="13.55" y="8.6" width="2.1" height="9.5" rx="1.05" fill="currentColor" opacity=".55"></rect>
  <ellipse cx="9.4" cy="18.1" rx="1.75" ry=".95" stroke="currentColor" stroke-width=".55" opacity=".385"></ellipse>
  <rect x="8.35" y="8.6" width="2.1" height="9.5" rx="1.05" fill="currentColor" opacity=".55"></rect>
  <ellipse cx="17.2" cy="19.6" rx="1.75" ry=".95" stroke="currentColor" stroke-width=".55" opacity=".21"></ellipse>
  <rect x="16.15" y="10.1" width="2.1" height="9.5" rx="1.05" fill="currentColor" opacity=".3"></rect>
  <ellipse cx="12" cy="19.6" rx="1.75" ry=".95" stroke="currentColor" stroke-width=".55" opacity=".7"></ellipse>
  <rect x="10.95" y="6.6" width="2.1" height="13" rx="1.05" fill="currentColor"></rect>
  <ellipse cx="6.8" cy="19.6" rx="1.75" ry=".95" stroke="currentColor" stroke-width=".55" opacity=".21"></ellipse>
  <rect x="5.75" y="10.1" width="2.1" height="9.5" rx="1.05" fill="currentColor" opacity=".3"></rect>
  <ellipse cx="14.6" cy="21.1" rx="1.75" ry=".95" stroke="currentColor" stroke-width=".55" opacity=".385"></ellipse>
  <rect x="13.55" y="11.6" width="2.1" height="9.5" rx="1.05" fill="currentColor" opacity=".55"></rect>
  <ellipse cx="9.4" cy="21.1" rx="1.75" ry=".95" stroke="currentColor" stroke-width=".55" opacity=".385"></ellipse>
  <rect x="8.35" y="11.6" width="2.1" height="9.5" rx="1.05" fill="currentColor" opacity=".55"></rect>
  <ellipse cx="12" cy="22.6" rx="1.75" ry=".95" stroke="currentColor" stroke-width=".55" opacity=".21"></ellipse>
  <rect x="10.95" y="13.1" width="2.1" height="9.5" rx="1.05" fill="currentColor" opacity=".3"></rect>
</svg>
