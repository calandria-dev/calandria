{
  "name": "calandria",
  "version": "0.6.2",
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n app,pty -c blue,green \"node server.js\" \"node pty-server.js\"",
    "dev:next": "node server.js",
    "pty": "node pty-server.js",
    "build": "cross-env NODE_ENV=production next build --turbopack",
    "start": "cross-env NODE_ENV=production node scripts/start.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:only": "playwright test",
    "desktop:install": "npm --prefix desktop install --include=dev --no-audit --no-fund && node desktop/node_modules/electron/install.js",
    "test:desktop:supervisor": "node desktop/test-supervisor.js",
    "test:desktop:boot": "node desktop/test-real-boot.js",
    "test:desktop:window": "playwright test --config playwright.desktop.config.ts",
    "test:desktop": "npm run test:desktop:supervisor && npm run test:desktop:boot && npm run test:desktop:window",
    "preflight": "npm test && npm run test:e2e",
    "test:docker": "bash scripts/docker-test.sh npm test",
    "typecheck:docker": "bash scripts/docker-test.sh npm run typecheck",
    "test:e2e:docker": "bash scripts/docker-test.sh --e2e npm run test:e2e",
    "preflight:docker": "bash scripts/docker-test.sh --e2e npm run preflight",
    "backup": "node scripts/backup.mjs",
    "postinstall": "node scripts/fix-pty.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.159",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language-data": "^6.5.2",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@openai/codex-sdk": "^0.146.0",
    "@uiw/react-codemirror": "^4.25.11",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "diff": "^8.0.4",
    "highlight.js": "^11.11.1",
    "jose": "^6.2.3",
    "mermaid": "^11.17.1",
    "nanoid": "^5.1.16",
    "next": "15.5.22",
    "node-pty": "^1.1.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "ws": "^8.21.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "20.17.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "typescript": "5.8.2",
    "vitest": "^3.2.6"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "sharp": "^0.35.3"
  }
}
