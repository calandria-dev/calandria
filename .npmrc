legacy-peer-deps=true
# Make the package.json engines floor (Node >=22) a hard failure rather than a
# warning. The native deps are N-API, so an install on an older Node otherwise
# appears to work and only diverges later. Two dependencies set the floor:
# @hono/node-server (via the MCP SDK) needs >=20, and better-sqlite3 13 declares
# >=22 — the latter is also what refuses a Node NEWER than it supports, with one
# line instead of a compiler wall, so keeping it strict is the point.
engine-strict=true
